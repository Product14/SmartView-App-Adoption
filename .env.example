# Server-side only (used by /api/sheet and the vite dev middleware).
# Defaults to the link-shared sheet's gviz CSV endpoint if unset.
SHEET_CSV_URL="https://docs.google.com/spreadsheets/d/1VDvn6ZcHfRYdjtVHi2aJ06tylbKX2TyC9Lvhg-0-078/gviz/tq?tqx=out:csv&gid=0"

# ── Studio Health Report (/api/studio-health-report, Vercel cron) ──
# The two matrix tabs of the same sheet. Use the plain CSV export (NOT gviz): these
# tabs mix value types per column and gviz silently drops the non-matching cells.
# Both default to the known sheet id + gid if unset; recipients reuse EMAIL_TO/CC/BCC/FROM.
STUDIO_HEALTH_CSV_URL="https://docs.google.com/spreadsheets/d/1VDvn6ZcHfRYdjtVHi2aJ06tylbKX2TyC9Lvhg-0-078/export?format=csv&gid=1632148391"
STUDIO_ADOPTION_CSV_URL="https://docs.google.com/spreadsheets/d/1VDvn6ZcHfRYdjtVHi2aJ06tylbKX2TyC9Lvhg-0-078/export?format=csv&gid=1323822955"
# "View Dashboard" button target for the Studio Health Report (defaults to the studio analytics app).
STUDIO_HEALTH_DASHBOARD_URL="https://analytics.spyne.ai/satudio"

# ── Daily internal report email (/api/scheduled-report, Vercel cron) ──
# Shared secret the Vercel cron sends as `Authorization: Bearer <CRON_SECRET>`.
# Leave UNSET locally so the endpoint needs no auth header during testing.
CRON_SECRET=""
# Internal email REST API endpoint (same one VIN Tracker uses).
INTERNAL_EMAIL_API_URL=""
# Recipients. EMAIL_TO is required; the rest are optional, comma-separated.
EMAIL_TO=""
EMAIL_CC=""
EMAIL_BCC=""
# Optional sender address.
FROM=""
# Optional — adds a "View Full Dashboard" button to the email.
DASHBOARD_URL=""
